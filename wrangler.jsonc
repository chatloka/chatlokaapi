{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatlokaapi",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "ENVIRONMENT": "production",
    "API_BASE_URL": "https://api.chatloka.net",
    "ENVATO_API_URL": "https://envatoapi.chatloka.net/v3/market",
    "BETTER_AUTH_URL": "https://api.chatloka.net",
    "TICKET_FROM_NAME": "Chatloka Support",
    "TICKET_FROM_EMAIL": "contact@support.chatloka.net",
    "TURNSTILE_SITE_KEY": "0x4AAAAAADbNEcF-YAzBslQ5k-DCBhlyqFM",
    "TELEGRAM_ADMIN_CHAT_ID": "7463670864",
    "TELEGRAM_BOT_USERNAME": "chatlokaapibot"
  },
  "secrets": {
    "required": [
      "DOWNLOAD_TOKEN_SECRET",
      "RSA_PRIVATE_KEY",
      "ENVATO_PERSONAL_TOKEN",
      "BETTER_AUTH_SECRET",
      "TURNSTILE_SECRET_KEY",
      "TELEGRAM_BOT_TOKEN",
      "TELEGRAM_WEBHOOK_SECRET",
      "MCP_API_KEY",
      "RESEND_API_KEY",
      "RESEND_WEBHOOK_SECRET",
      "OPENAI_API_KEY"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chatloka",
      "database_id": "19053391-e143-4cfa-a233-2f469efb2669",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "PLUGINS_BUCKET",
      "bucket_name": "chatlokaapi",
      "remote": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME_DO",
        "class_name": "RealtimeHub"
      }
    ]
  },
  "workflows": [
    {
      "name": "ticket-ai-analysis",
      "binding": "TICKET_AI_WORKFLOW",
      "class_name": "TicketAiWorkflow"
    }
  ],
  "migrations": [
    {
      "tag": "v1-realtime",
      "new_sqlite_classes": ["RealtimeHub"]
    }
  ],
  "ratelimits": [
    {
      "name": "RL_VALIDATE",
      "namespace_id": "21001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "RL_ACTIVATE",
      "namespace_id": "21002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "RL_VERIFY",
      "namespace_id": "21006",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "RL_DEACTIVATE",
      "namespace_id": "21003",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "RL_PLUGIN_TOKEN",
      "namespace_id": "21004",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "RL_PLUGIN_DOWNLOAD",
      "namespace_id": "21005",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
